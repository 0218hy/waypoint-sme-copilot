# Copy to .env (never commit .env). All optional: without a model key every card, number and rule works,
# and the chat shows a notice with Retry where the model's words would be. See docs/MODELS.md.
# Model credentials (config/models.yaml picks the provider and model per role)
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
WAYPOINT_LLM_PROVIDER=anthropic
WAYPOINT_LLM_MODEL=
# Or an OpenAI-compatible endpoint, e.g. Qwen on Alibaba Cloud Model Studio (not yet tested in this build;
# the base URL depends on your key's region):
# WAYPOINT_LLM_PROVIDER=openai
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_API_KEY=
# WAYPOINT_LLM_MODEL=qwen-plus
# WAYPOINT_LLM_READER_MODEL=qwen-vl-plus
# App
# Demo mode is for local judging only: it serves /api/demo/* (a mock SSO token, the clock, a sample
# quote) and the API docs. Set WAYPOINT_DEMO=0 for anything reachable by others.
WAYPOINT_DEMO=1
WAYPOINT_BASE_URL=http://127.0.0.1:8000
# Signs SSO tokens and check-in links. Leave blank and the app generates a random one at start-up
# (links from emails then stop working after a restart); set a long random value to keep them, e.g.
# `python -c "import secrets; print(secrets.token_hex(32))"`. A placeholder such as "change-me" is
# refused outside demo mode.
WAYPOINT_SSO_SECRET=
WAYPOINT_COOKIE_SECURE=0
WAYPOINT_SMTP_HOST=127.0.0.1
WAYPOINT_SMTP_PORT=1025
WAYPOINT_MAIL_FROM=Waypoint <no-reply@waypoint.test>
WAYPOINT_MAILPIT_URL=http://127.0.0.1:8025
# Weekly Goal Keeper job (APScheduler). Default: on outside demo mode and tests; uncomment and set 1/0 to
# force it (any value set here, even an empty one, overrides the default).
# It ticks every N minutes and only does what is due (one check per goal per week, one email per period).
# WAYPOINT_SCHEDULER=1
WAYPOINT_SCHEDULER_MINUTES=60
# Public data (optional): LTA DataMall key for station passenger volumes
LTA_ACCOUNT_KEY=
